{
  "opencollection": "1.0.0",
  "info": {
    "name": "Codesphere Public clusters usage API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getUsageSummaryLandscape",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.codesphere.com/api/usage/teams/:teamId/resources/landscape-service/summary",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              },
              {
                "name": "beginDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the usage summary of all Landscape Services for a team over the specified time period."
        },
        {
          "info": {
            "name": "getLandscapeServiceEvents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.codesphere.com/api/usage/teams/:teamId/resources/landscape-service/:resourceId/events",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "path"
              },
              {
                "name": "beginDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns Audit-Events for a specific Landscape Service."
        }
      ]
    }
  ],
  "bundled": true
}